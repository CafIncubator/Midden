@page "/editor/project"
@using Caf.Midden.Core.Models.v0_2
@using System
@using System.Linq

@inject Services.StateContainer State

<div class="site-layout-background">
    <PageHeader Title="Project Editor" />
       <ProjectEditor />
    <BackTop></BackTop>
</div>

@code {
    [SupplyParameterFromQuery(Name = "name")]
    public string? Name { get; set; }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(Name))
        {
            var existingProject = State.Catalog?.Projects?.FirstOrDefault(p =>
                p.Name.Equals(Name, StringComparison.OrdinalIgnoreCase));

            State.UpdateProjectEdit(this, existingProject ?? new Project { Name = Name });
        }
    }
}