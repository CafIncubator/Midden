@using AntDesign
@using Caf.Midden.Core.Services.Validation
@using Caf.Midden.Wasm.Shared.Validation
@inject Caf.Midden.Wasm.Services.StateContainer State
@inject Caf.Midden.Wasm.Services.AutosaveService Autosave
@inject ModalService ModalService
@inject IJSRuntime JS

<Space>
    <SpaceItem>
        <Popconfirm Title="Confirm reset"
                    OkText="Reset"
                    CancelText="Cancel"
                    OnConfirm="NewMetadata">
            <Button><Icon Type="plus" Theme="@IconThemeType.Outline" /> New</Button>
        </Popconfirm>
    </SpaceItem>
    <SpaceItem>
        <MetadataLoaderFileSystem Metadata="State.MetadataEdit"
                      MetadataChanged="OnMetadataLoaded" />
    </SpaceItem>
    <SpaceItem>
        <span class="autosave-status">@AutosaveStatusText</span>
    </SpaceItem>
    <SpaceItem>
        <ValidationStatusChip Result="_validation" />
    </SpaceItem>
    <SpaceItem>
        @* Completeness is deliberately separate from validity: it rewards effort instead of
           blocking the download. *@
        <AntDesign.Tooltip Title="@CompletenessTooltip">
            <span class="validation-status">@CompletenessText</span>
        </AntDesign.Tooltip>
    </SpaceItem>
</Space>
<AntDesign.Divider />

@* Rendered declaratively (rather than via ConfirmService) so the prompt is owned by this
   component's own render tree. The shared AntContainer resets its imperative dialog state on
   NavigationManager.LocationChanged, which silently discarded confirm dialogs requested during
   the navigation that creates this editor. *@
<Modal Title="@("Resume Draft?")"
       Visible="_draftRestorePromptVisible"
       OkText="@("Yes")"
       CancelText="@("No")"
       OnOk="@(_ => OnDraftRestoreAccepted())"
       OnCancel="@(_ => OnDraftRestoreDeclined())"
       MaskClosable="false"
       Closable="false">
    <p>@DraftRestorePromptText</p>
</Modal>

@if (State?.MetadataEdit != null && State?.AppConfig != null)
{
    <AntDesign.Form Model="State.MetadataEdit"
                    Layout="@FormLayout.Vertical"
                    OnFieldChanged="OnFormFieldChanged"
                    @ref="form">
        <Tabs Animated @bind-ActiveKey="_activeTabKey">
            <TabPane Key="1" Tab="@BasicTabLabel">
                <EditorFormItemWithHelpPopup 
                    Label="Zone" 
                    Id="zone" 
                    Tooltip="@ZoneTooltip"
                    Rules="@(new FormValidationRule[] { new FormValidationRule{ Required = true }})">
                    <SimpleSelect Id="zone" @bind-Value="@context.Dataset.Zone"
                                    Placeholder="Zone that holds dataset">
                            <SelectOptions>
                                @foreach (var zone in State.AppConfig.Zones)
                                {
                                <SimpleSelectOption Value=@zone Label=@zone />
                                }
                            </SelectOptions>
                        </SimpleSelect>
                </EditorFormItemWithHelpPopup>
               
                <EditorFormItemWithHelpPopup 
                    Label="Name" 
                    Id="name" 
                    Tooltip="@DatasetNameTooltip"
                    Rules="@(new FormValidationRule[] { new FormValidationRule{ Required = true, Type = FormFieldType.String, Min = 2 }})">
                    <AntDesign.Input Id="name" @bind-Value="context.Dataset.Name"
                                                    Placeholder="Name of dataset" />
                </EditorFormItemWithHelpPopup>
                
                <EditorFormItemWithHelpPopup 
                    Label="Project" 
                    Id="project" 
                    Tooltip="@ProjectTooltip"
                    Rules="@(new FormValidationRule[] { new FormValidationRule{ Required = true, Type = FormFieldType.String, Min = 2 }})">
                    <AntDesign.Input Id="project" @bind-Value="context.Dataset.Project"
                                        Placeholder="Name of project that produced the dataset" />
                </EditorFormItemWithHelpPopup>

                <EditorFormItemWithHelpPopup 
                    Label="Description" 
                    Id="description" 
                    Tooltip="@DatasetDescriptionTooltip" IsRequired=false>
                    <MarkdownEditor @bind-Value="@context.Dataset.Description"
                            ValueHTMLChanged="@OnMarkdownDescriptionValueHTMLChanged" />
                </EditorFormItemWithHelpPopup>

                <EditorFormItemWithHelpPopup 
                    Label="Contacts" 
                    Id="contacts" 
                    Tooltip="@ContactsTooltip">
                    <Button OnClick="AddContactHandler">Add</Button>
                    <br /><br />
                    @if (context.Dataset.Contacts.Count > 0)
                    {
                        <AntDesign.Table TItem="Caf.Midden.Core.Models.v0_2.Person"
                                            DataSource="@context.Dataset.Contacts"
                                            OnRow="@GetContactRowAttributes"
                                            RowClassName="@GetContactRowClassName"
                                            HidePagination="@true">
                            <ChildContent Context="contact">
                                <AntDesign.PropertyColumn Property="@(item => item.Name)" Title="" Width="4%">
                                    <span draggable="true"
                                          class="string-list-editor-handle"
                                          title="Drag to reorder"
                                          @ondragstart="@(() => OnContactDragStart(contact))"
                                          @ondragend="@OnContactDragEnd">⋮⋮</span>
                                </AntDesign.PropertyColumn>
                                <AntDesign.PropertyColumn Property="@(item => item.Name)"
                                                            Width="30%" />
                                <AntDesign.PropertyColumn Property="@(item => item.Email)"
                                                            Width="30%" />
                                <AntDesign.PropertyColumn Property="@(item => item.Role)"
                                                            Width="30%" />
                                <ActionColumn Title="Action">
                                    <Space>
                                        <SpaceItem>
                                            <Button OnClick="() => OpenPersonModalTemplate(contact)">
                                                <Icon Type="edit" />
                                            </Button>
                                        </SpaceItem>
                                        <SpaceItem>
                                            <Button Danger OnClick="() => DeleteContactHandler(contact)">
                                                <Icon Type="delete" />
                                            </Button>
                                        </SpaceItem>
                                    </Space>
                                </ActionColumn>
                            </ChildContent>

                        </AntDesign.Table>
                    }
                </EditorFormItemWithHelpPopup>

                <EditorFormItemWithHelpPopup Label="Tags" Id="tags" Tooltip="@DatasetTagsTooltip" IsRequired=false>
                    <Space Style="width:100%;">
                        <SpaceItem>
                            <Input @bind-Value="NewDatasetTag" />
                        </SpaceItem>
                        <SpaceItem>
                            <Button OnClick="AddDatasetTagHandler">Add</Button>
                        </SpaceItem>
                        <SpaceItem><Divider Type="@DividerType.Vertical" /></SpaceItem>
                        <div style="width: 100%;">
                            <SpaceItem>
                                <SimpleSelect Placeholder="Add saved tag"
                                                OnSelectedItemChanged="DatasetTagSelectedItemChangedHandler"
                                                EnableSearch
                                                @bind-Value="SavedDatasetTag"
                                                AutoClearSearchValue>
                                    <SelectOptions>
                                        @foreach (var tag in State.AppConfig.Tags)
                                        {
                                            <SimpleSelectOption Value=@tag Label=@tag />
                                        }
                                    </SelectOptions>
                                </SimpleSelect>
                            </SpaceItem>
                        </div>
                    </Space>

                    <br />

                    @if (context.Dataset.Tags.Count > 0)
                    {
                        <div class="string-list-editor">
                            @for (int i = 0; i < context.Dataset.Tags.Count; i++)
                            {
                                var index = i;
                                var tag = context.Dataset.Tags[index];
                                <div class="string-list-editor-drop-indicator @(IsStringDragOver(DatasetStringListKind.Tags, index) ? "string-list-editor-drop-indicator-visible" : string.Empty)"></div>
                                <div draggable="true"
                                     class="string-list-editor-row"
                                     @ondragstart="@(() => OnStringDragStart(DatasetStringListKind.Tags, index))"
                                     @ondragenter="@(() => OnStringDragEnter(DatasetStringListKind.Tags, index))"
                                     @ondragover:preventDefault
                                     @ondrop="@(() => OnStringDrop(DatasetStringListKind.Tags, index))"
                                     @ondragend="@OnStringDragEnd">
                                    <span class="string-list-editor-handle" title="Drag to reorder" aria-hidden="true">⋮⋮</span>
                                    <div class="string-list-editor-input"><Tag>@tag</Tag></div>
                                    <Button Danger OnClick="() => DeleteDatasetTagHandler(tag)">
                                        <Icon Type="delete" />
                                    </Button>
                                </div>
                            }
                            <div class="string-list-editor-drop-indicator @(IsStringDragOver(DatasetStringListKind.Tags, context.Dataset.Tags.Count) ? "string-list-editor-drop-indicator-visible" : string.Empty)"
                                 @ondragenter="@(() => OnStringDragEnter(DatasetStringListKind.Tags, context.Dataset.Tags.Count))"
                                 @ondragover:preventDefault
                                 @ondrop="@(() => OnStringDrop(DatasetStringListKind.Tags, context.Dataset.Tags.Count))"></div>
                        </div>
                    }
                </EditorFormItemWithHelpPopup>

            </TabPane>
            <TabPane Key="2" Tab="@VariablesTabLabel">

                <EditorFormItemWithHelpPopup Label="Variables" Id="variables" Tooltip="@VariablesTooltip" IsRequired=false>
                    <Space>
                        <SpaceItem>
                            <Button OnClick="AddVariableHandler">Add</Button>
                        </SpaceItem>
                        <SpaceItem>
                            <DataDictionaryLoaderCafCsv />
                        </SpaceItem>
                        <SpaceItem>
                            <AntDesign.Tooltip Title="@("WARNING: Uploading will replace all current variables. The uploaded file must be a CSV with a Name, Description, and Units column; those three are the only ones required, so a minimal 3-column CSV is accepted. Optional columns: Tags, Methods, TemporalResolution, TemporalExtent, SpatialRepeats, IsQCSpecified, QCApplied, ProcessingLevel, VariableType. Tags, Methods, and QCApplied support multiple values within a cell, separated by a semicolon (;). If any value contains a comma, wrap it in double quotes so it isn't mistaken for a column separator. This is the same format produced by the \"Download\" button in the dataset preview, so a downloaded data dictionary can be edited and re-uploaded as-is.")">
                                <Icon Type="info-circle" Theme="@IconThemeType.Fill" />
                            </AntDesign.Tooltip>
                        </SpaceItem>
                    </Space>

                    <br /><br />
                   

                    @if (context.Dataset.Variables.Count > 0)
                    {
                        <AntDesign.Table TItem="Caf.Midden.Core.Models.v0_2.Variable"
                                            DataSource="@context.Dataset.Variables"
                                            OnRow="@GetVariableRowAttributes"
                                            RowClassName="@GetVariableRowClassName"
                                            Size="@TableSize.Small"
                                            ScrollX="1400"
                                            PageSize="50">
                            <ChildContent Context="variable">
                                <AntDesign.PropertyColumn Property="@(item => item.Name)" Title="" Width="45px" Fixed="@AntDesign.ColumnFixPlacement.Left">
                                    <span draggable="true"
                                          class="string-list-editor-handle"
                                          title="Drag to reorder"
                                          @ondragstart="@(() => OnVariableDragStart(variable))"
                                          @ondragend="@OnVariableDragEnd">⋮⋮</span>
                                </AntDesign.PropertyColumn>
                                <AntDesign.PropertyColumn Property="@(item => item.Name)"
                                                            Fixed="@AntDesign.ColumnFixPlacement.Left">
                                                    @if(VariableQuickEditRef == variable)
                                                    {
                                    <Input @bind-Value="QuickEditViewModel.Variable.Name" />
                                }
                                else
                                {
                                    <div>@variable.Name</div>
                                }

                                                    </AntDesign.PropertyColumn>
                                <AntDesign.PropertyColumn Property="@(item => item.Description)"
                                                            Ellipsis />
                                <AntDesign.PropertyColumn Property="@(item => item.Units)">
                                    @if(VariableQuickEditRef == variable)
                                    {
                                    <Input @bind-Value="QuickEditViewModel.Variable.Units" />
                                }
                                else
                                {
                                    <div>@variable.Units</div>
                                }
                            </AntDesign.PropertyColumn>
                                <AntDesign.PropertyColumn Property="@(item => item.Methods)"
                                                            Ellipsis>
                                    @foreach (var method in variable.Methods)
                                        {
                                        <p>@method</p>
                                        }
                                </AntDesign.PropertyColumn>

                                <AntDesign.PropertyColumn Property="@(item => item.QCApplied)"
                                                            Title="Quality Control">
                                @if(VariableQuickEditRef == variable)
                                {
                                    <Select Mode="@SelectMode.Multiple"
                                            Placeholder="Select Quality Control"
                                            @bind-Values="QuickEditViewModel.SelectedQCApplied"
                                            TItemValue="string"
                                            TItem="string">
                                        <SelectOptions>
                                            @foreach (var item in QuickEditViewModel.QCFlags)
                                            {
                                                <SelectOption TItemValue="string" TItem="string" Value=@item Label=@item />
                                            }
                                        </SelectOptions>
                                    </Select>
                                }
                                else
                                {
                                    @foreach (var qc in variable.QCApplied)
                                    {
                                        <Tag>@qc</Tag>
                                    }
                                }
                                
                                </AntDesign.PropertyColumn>


                                <AntDesign.PropertyColumn Property="@(item => item.ProcessingLevel)"
                                                            Title="Processing">
                                @if(VariableQuickEditRef == variable)
                                {
                                    <SimpleSelect Id="variable-processing" @bind-Value="@QuickEditViewModel.Variable.ProcessingLevel"
                                                  Placeholder="Processing Level">
                                        <SelectOptions>
                                            @foreach (var item in QuickEditViewModel.ProcessingLevels)
                                            {
                                                <SimpleSelectOption Value=@item Label=@item />
                                            }
                                        </SelectOptions>
                                    </SimpleSelect>
                                }
                                else
                                {
                                    <Tag>@variable.ProcessingLevel</Tag>
                                }
                                
                                </AntDesign.PropertyColumn>


                            <AntDesign.PropertyColumn Property="@(item => item.VariableType)"
                                                      Title="Type">
                                @if(VariableQuickEditRef == variable)
                                {
                                    <SimpleSelect Id="variable-type" @bind-Value="@QuickEditViewModel.Variable.VariableType"
                                                  Placeholder="Variable Type">
                                        <SelectOptions>
                                            @foreach (var item in QuickEditViewModel.VariableTypes)
                                            {
                                                <SimpleSelectOption Value=@item Label=@item />
                                            }
                                        </SelectOptions>
                                    </SimpleSelect>
                                }
                                else
                                {
                                    <Tag>@variable.VariableType</Tag>
                                }
                                
                            </AntDesign.PropertyColumn>

                                <AntDesign.PropertyColumn Property="@(item => item.Tags)">
                                    @foreach (var tag in variable.Tags)
                                        {
                                        <Tag>@tag</Tag>
                                        }
                                </AntDesign.PropertyColumn>
<!-- Depricated                 <AntDesign.Column @bind-Field="variable.Height" /> -->
                                <ActionColumn Title="Action"
                                                Fixed="@AntDesign.ColumnFixPlacement.Right">
                                    <Space>
                                    <SpaceItem>
                                        @if(VariableQuickEditRef == variable)
                                            {
                                                <Button Type="@ButtonType.Link" OnClick="()=>EndQuickEdit()"><Icon Type="check"></Icon></Button>
                                            }
                                            else
                                            {
                                                <Button Type="@ButtonType.Link" OnClick="()=>StartQuickEdit(variable)"><Icon Type="edit"></Icon></Button>
                                            }
                                        </SpaceItem>
                                        <SpaceItem>
                                            <Button OnClick="() => OpenVariableModalTemplate(variable)">
                                                <Icon Type="edit" />
                                            </Button>
                                        </SpaceItem>
                                        <SpaceItem>
                                            <Button Danger OnClick="() => DeleteVariableHandler(variable)">
                                                <Icon Type="delete" />
                                            </Button>
                                        </SpaceItem>
                                    </Space>
                                </ActionColumn>
                            </ChildContent>
                        </AntDesign.Table>
                    }
                </EditorFormItemWithHelpPopup>

            </TabPane>
            <TabPane Key="3" Tab="@CoverageTabLabel">
                <EditorFormItemWithHelpPopup Label="Spatial Repeats" Id="spatial-repeats" Tooltip="@SpatialRepeatsTooltip" IsRequired=false>
                    <AntDesign.InputNumber Id="spatial-repeats"
                                            @bind-Value="context.Dataset.SpatialRepeats" />
                </EditorFormItemWithHelpPopup>

                <EditorFormItemWithHelpPopup Label="Spatial Extent" Id="spatial-extent" Tooltip="@SpatialExtentTooltip" IsRequired=false>
                    <FormItem>
                        <SimpleSelect Id="spatial-extent" @bind-Value="this.GeometryTemplate"
                                        Placeholder="Saved values"
                                        AllowClear="true"
                                        OnSelectedItemChanged="OnGeometryItemChangedHandler">
                            <SelectOptions>
                                @if (State.AppConfig.Geometries != null)
                                {
                                    @foreach (var geom in State.AppConfig.Geometries)
                                    {
                                        <SimpleSelectOption Value="@geom.GeoJson"
                                                            Label="@geom.Name" />
                                    }
                                }
                            </SelectOptions>
                        </SimpleSelect>
                    </FormItem>
                    <FormItem>
                        <GeoJsonEditorMap Value="@context.Dataset.Geometry"
                                          ValueChanged="@((string v) => OnMapGeometryChanged(context.Dataset, v))" />
                    </FormItem>
                </EditorFormItemWithHelpPopup>

                <EditorFormItemWithHelpPopup Label="Temporal Resolution" Id="temporal-resolution" Tooltip="@TemporalResolutionTooltip" IsRequired=false>
                    <AntDesign.Input Id="temporal-resolution" @bind-Value="context.Dataset.TemporalResolution"
                                        Placeholder="e.g. '15 min'" />
                </EditorFormItemWithHelpPopup>

                <EditorFormItemWithHelpPopup Label="Temporal Extent" Id="temporal-extent" Tooltip="@TemporalExtentTooltip" IsRequired=false>
                    <AntDesign.Input Id="temporal-extent" @bind-Value="context.Dataset.TemporalExtent"
                                 Placeholder="YYYY-MM-DD/YYYY-MM-DD" />
                </EditorFormItemWithHelpPopup>

            </TabPane>
            <TabPane Key="4" Tab="@StructureTabLabel">
                <EditorFormItemWithHelpPopup Label="File Format" Id="file-format" Tooltip="@FileFormatTooltip" IsRequired=false>
                    <AntDesign.Input Id="file-format" @bind-Value="context.Dataset.Format"
                                 Placeholder="Format, usually file extension" />
                </EditorFormItemWithHelpPopup>

                <EditorFormItemWithHelpPopup Label="File Path Template" Id="file-path-template" Tooltip="@FilePathTemplateTooltip" IsRequired=false>
                    <AntDesign.Input Id="file-path-template" @bind-Value="context.Dataset.FilePathTemplate"
                                 Placeholder="e.g. '{YYYY}/Filename_{YYYYMMDD}.csv'" />
                </EditorFormItemWithHelpPopup>

                <EditorFormItemWithHelpPopup Label="File Path Description" Id="file-path-description" Tooltip="@FilePathDescriptionTooltip" IsRequired=false>
                    <AntDesign.TextArea Id="file-path-description" @bind-Value="context.Dataset.FilePathDescriptor"
                                        Placeholder="Describe template values; e.g. {YYYY}" />
                </EditorFormItemWithHelpPopup>

                <EditorFormItemWithHelpPopup Label="Dataset Structure" Id="dataset-structure" Tooltip="@DatasetStructureTooltip" IsRequired=false>
                    <SimpleSelect Id="dataset-structure" @bind-Value="context.Dataset.Structure"
                              Placeholder="Select">
                        <SelectOptions>
                            @if (State.AppConfig.DatasetStructures != null)
                            {
                                @foreach (var structure in State.AppConfig.DatasetStructures)
                                {
                                    <AntDesign.SimpleSelectOption Value="@structure"
                                                      Label="@structure" />
                                }
                            }
                        </SelectOptions>
                    </SimpleSelect>
                </EditorFormItemWithHelpPopup>


            </TabPane>
            <TabPane Key="5" Tab="@ProcessingTabLabel">

                <EditorFormItemWithHelpPopup Label="Methods" Id="methods" Tooltip="@DatasetMethodsTooltip" IsRequired=false>
                    <InputGroup>
                        <Row Justify="@RowJustify.SpaceBetween">
                            <AntDesign.Col Span="20">
                                <Input Id="methods" @bind-Value="NewDatasetMethod"
                                    Placeholder="Enter URL, text, or markdown"/>
                            </AntDesign.Col>
                            <AntDesign.Col Span="4">
                                <Button OnClick="AddDatasetMethodHandler">Add</Button>
                            </AntDesign.Col>
                        </Row>
                    </InputGroup>
                    <br />
                    @if (context.Dataset.Methods.Count > 0)
                    {
                        <div class="string-list-editor">
                            @for (int i = 0; i < context.Dataset.Methods.Count; i++)
                            {
                                var index = i;
                                var method = context.Dataset.Methods[index];
                                <div class="string-list-editor-drop-indicator @(IsStringDragOver(DatasetStringListKind.Methods, index) ? "string-list-editor-drop-indicator-visible" : string.Empty)"></div>
                                <div draggable="true"
                                     class="string-list-editor-row"
                                     @ondragstart="@(() => OnStringDragStart(DatasetStringListKind.Methods, index))"
                                     @ondragenter="@(() => OnStringDragEnter(DatasetStringListKind.Methods, index))"
                                     @ondragover:preventDefault
                                     @ondrop="@(() => OnStringDrop(DatasetStringListKind.Methods, index))"
                                     @ondragend="@OnStringDragEnd">
                                    <span class="string-list-editor-handle" title="Drag to reorder" aria-hidden="true">⋮⋮</span>
                                    <div class="string-list-editor-input"><Text>@method</Text></div>
                                    <Button Danger OnClick="() => DeleteDatasetMethodHandler(method)">
                                        <Icon Type="delete" />
                                    </Button>
                                </div>
                            }
                            <div class="string-list-editor-drop-indicator @(IsStringDragOver(DatasetStringListKind.Methods, context.Dataset.Methods.Count) ? "string-list-editor-drop-indicator-visible" : string.Empty)"
                                 @ondragenter="@(() => OnStringDragEnter(DatasetStringListKind.Methods, context.Dataset.Methods.Count))"
                                 @ondragover:preventDefault
                                 @ondrop="@(() => OnStringDrop(DatasetStringListKind.Methods, context.Dataset.Methods.Count))"></div>
                        </div>
                    }
                </EditorFormItemWithHelpPopup>

                <EditorFormItemWithHelpPopup Label="Parent Datasets" Id="parent-datasets" Tooltip="@ParentDatasetsTooltip" IsRequired=false>
                    <InputGroup>
                        <Row Justify="@RowJustify.Start">
                            <AntDesign.Col Span="20">
                                <Input Id="parent-datasets" @bind-Value="NewParentDataset"
                                   Placeholder="Enter URL" />
                            </AntDesign.Col>
                            <AntDesign.Col Span="4">
                                <Button OnClick="AddParentDatasetHandler">Add</Button>
                            </AntDesign.Col>
                        </Row>
                    </InputGroup>
                    <br />
                    @if (context.Dataset.ParentDatasets.Count > 0)
                    {
                        <div class="string-list-editor">
                            @for (int i = 0; i < context.Dataset.ParentDatasets.Count; i++)
                            {
                                var index = i;
                                var parentDataset = context.Dataset.ParentDatasets[index];
                                <div class="string-list-editor-drop-indicator @(IsStringDragOver(DatasetStringListKind.ParentDatasets, index) ? "string-list-editor-drop-indicator-visible" : string.Empty)"></div>
                                <div draggable="true"
                                     class="string-list-editor-row"
                                     @ondragstart="@(() => OnStringDragStart(DatasetStringListKind.ParentDatasets, index))"
                                     @ondragenter="@(() => OnStringDragEnter(DatasetStringListKind.ParentDatasets, index))"
                                     @ondragover:preventDefault
                                     @ondrop="@(() => OnStringDrop(DatasetStringListKind.ParentDatasets, index))"
                                     @ondragend="@OnStringDragEnd">
                                    <span class="string-list-editor-handle" title="Drag to reorder" aria-hidden="true">⋮⋮</span>
                                    <div class="string-list-editor-input"><Text>@parentDataset</Text></div>
                                    <Button Danger OnClick="() => DeleteParentDatasetHandler(parentDataset)">
                                        <Icon Type="delete" />
                                    </Button>
                                </div>
                            }
                            <div class="string-list-editor-drop-indicator @(IsStringDragOver(DatasetStringListKind.ParentDatasets, context.Dataset.ParentDatasets.Count) ? "string-list-editor-drop-indicator-visible" : string.Empty)"
                                 @ondragenter="@(() => OnStringDragEnter(DatasetStringListKind.ParentDatasets, context.Dataset.ParentDatasets.Count))"
                                 @ondragover:preventDefault
                                 @ondrop="@(() => OnStringDrop(DatasetStringListKind.ParentDatasets, context.Dataset.ParentDatasets.Count))"></div>
                        </div>
                    }
                </EditorFormItemWithHelpPopup>

                <EditorFormItemWithHelpPopup Label="Derived Works" Id="derived-works" Tooltip="@DerivedWorksTooltip" IsRequired=false>
                    <InputGroup>
                        <Row Justify="@RowJustify.Start">
                            <AntDesign.Col Span="20">
                                <Input Id="derived-works" @bind-Value="NewDerivedWork" />
                            </AntDesign.Col>
                            <AntDesign.Col Span="4">
                                <Button OnClick="AddDerivedWorkHandler">Add</Button>
                            </AntDesign.Col>
                        </Row>
                    </InputGroup>
                    <br />
                    @if (context.Dataset.DerivedWorks.Count > 0)
                    {
                        <div class="string-list-editor">
                            @for (int i = 0; i < context.Dataset.DerivedWorks.Count; i++)
                            {
                                var index = i;
                                var derived = context.Dataset.DerivedWorks[index];
                                <div class="string-list-editor-drop-indicator @(IsStringDragOver(DatasetStringListKind.DerivedWorks, index) ? "string-list-editor-drop-indicator-visible" : string.Empty)"></div>
                                <div draggable="true"
                                     class="string-list-editor-row"
                                     @ondragstart="@(() => OnStringDragStart(DatasetStringListKind.DerivedWorks, index))"
                                     @ondragenter="@(() => OnStringDragEnter(DatasetStringListKind.DerivedWorks, index))"
                                     @ondragover:preventDefault
                                     @ondrop="@(() => OnStringDrop(DatasetStringListKind.DerivedWorks, index))"
                                     @ondragend="@OnStringDragEnd">
                                    <span class="string-list-editor-handle" title="Drag to reorder" aria-hidden="true">⋮⋮</span>
                                    <div class="string-list-editor-input"><Text>@derived</Text></div>
                                    <Button Danger OnClick="() => DeleteDerivedWorkHandler(derived)">
                                        <Icon Type="delete" />
                                    </Button>
                                </div>
                            }
                            <div class="string-list-editor-drop-indicator @(IsStringDragOver(DatasetStringListKind.DerivedWorks, context.Dataset.DerivedWorks.Count) ? "string-list-editor-drop-indicator-visible" : string.Empty)"
                                 @ondragenter="@(() => OnStringDragEnter(DatasetStringListKind.DerivedWorks, context.Dataset.DerivedWorks.Count))"
                                 @ondragover:preventDefault
                                 @ondrop="@(() => OnStringDrop(DatasetStringListKind.DerivedWorks, context.Dataset.DerivedWorks.Count))"></div>
                        </div>
                    }
                </EditorFormItemWithHelpPopup>

            </TabPane>
        </Tabs>
    </AntDesign.Form>
    <Divider />
    <Row Justify="@RowJustify.End">
        <Space>
            @* Repeated from the toolbar so the state is visible at the point of action. *@
            <SpaceItem>
                <ValidationStatusChip Result="_validation" Announce="false" />
            </SpaceItem>
            <SpaceItem>
                <Button Type="default" OnClick="() => OpenMetadataDetailsModalTemplate(State.MetadataEdit)">
                    <Icon Type="eye" />
                    Preview
                </Button>
            </SpaceItem>
            <SpaceItem>
                <Button Type="@ButtonType.Primary" OnClick="RequestDownload">
                    <Icon Type="download" />
                    Download
                </Button>
            </SpaceItem>
        </Space>
    </Row>

    @* Selecting an issue switches to the tab that owns it, which matters here because AntDesign
       renders tab panes lazily and the offending field may never have been on screen. *@
    <ValidationGate @ref="_validationGate"
                    OnConfirmed="@(() => SaveDataset())"
                    OnIssueSelected="@OnValidationIssueSelected" />
}
else
{
    <p>No Metadata loaded</p>
}