@using Caf.Midden.Wasm.Shared.MetadataLineage
@using Caf.Midden.Wasm.Shared.MetadataSections
@inject Caf.Midden.Wasm.Services.StateContainer State

@if (Metadata != null)
{
    <PageHeader Class="site-page-header" Title="@Metadata.Dataset.Name" Subtitle="@($"Last updated: {Metadata.ModifiedDate}")" />

    <Row>
        <AntDesign.Col Span="24" Style="padding:5px">
            <Icon Type="folder" />
            <a href="catalog/datasets/@Metadata.Dataset.Zone">@Metadata.Dataset.Zone</a>
            <Divider Type="DirectionVHType.Vertical" />
            <Icon Type="project" />
            <a href="catalog/projects/@Metadata.Dataset.Project">@Metadata.Dataset.Project</a>
        </AntDesign.Col>
    </Row>

    <Divider />

    <div class="details-quick-peek-wrap">
        <div class="details-quick-peek-header">
            <span class="details-quick-peek-title">Quick Peek</span>
            <span class="details-quick-peek-subtitle">Open any section in a focused modal preview.</span>
        </div>

        <div class="details-quick-peek">
            <AntDesign.Button Size="small" Disabled="@(!HasDescription)" @onclick="@(() => ShowDescription = true)"><Icon Type="read" Theme="outline" /> Description</AntDesign.Button>
            <AntDesign.Button Size="small" Disabled="@(!HasMethods)" @onclick="@(() => ShowDatasetMethods = true)"><Icon Type="experiment" Theme="outline" /> Methods</AntDesign.Button>
            <AntDesign.Button Size="small" Disabled="@(!HasLineage)" @onclick="@(() => ShowLineage = true)"><Icon Type="partition" Theme="outline" Rotate="180" /> Lineage Diagram</AntDesign.Button>
            <AntDesign.Button Size="small" Disabled="@(!HasDerivedWorks)" @onclick="@(() => ShowDerivedWorks = true)"><Icon Type="comment" Theme="outline" /> Derived Works</AntDesign.Button>
            <AntDesign.Button Size="small" Disabled="@(!HasFileInformation)" @onclick="@(() => ShowFileInformation = true)"><Icon Type="database" Theme="outline" /> File Information</AntDesign.Button>
            <AntDesign.Button Size="small" Disabled="@(!HasVariables)" @onclick="@(() => ShowVariables = true)"><Icon Type="calculator" Theme="outline" /> Variables</AntDesign.Button>
            <AntDesign.Button Size="small" Disabled="@(!HasSpatialInformation)" @onclick="@(() => ShowSpatialInformation = true)"><Icon Type="environment" Theme="outline" /> Spatial Information</AntDesign.Button>
            <AntDesign.Button Size="small" Disabled="@(!HasTemporalInformation)" @onclick="@(() => ShowTemporalInformation = true)"><Icon Type="clock-circle" Theme="outline" /> Temporal Information</AntDesign.Button>
            <AntDesign.Button Size="small" Disabled="@(!HasContacts)" @onclick="@(() => ShowContacts = true)"><Icon Type="user" Theme="outline" /> Contacts</AntDesign.Button>
            <AntDesign.Button Size="small" Disabled="@(!HasTags)" @onclick="@(() => ShowTags = true)"><Icon Type="tags" Theme="outline" /> Tags</AntDesign.Button>
        </div>
    </div>

    <Row>
        <AntDesign.Col Xs="@Property(24,0)" Lg="@Property(17,0)">
            <Row>
                <AntDesign.Col Span="24" Style="padding:5px">
                    <Card>
                        <TitleTemplate>
                            <Icon Type="read" Theme="outline" /> Description
                        </TitleTemplate>
                        <Body>
                            <DatasetDescriptionSection DescriptionHtml="@DescriptionHtml" CanExpand="@CanExpandDescription" IsExpanded="@IsDescriptionExpanded" OnToggle="@ToggleDescription" />
                        </Body>
                    </Card>
                </AntDesign.Col>
            </Row>

            <Row>
                <AntDesign.Col Span="24" Style="padding:5px">
                    <Card>
                        <TitleTemplate>
                            <Icon Type="experiment" Theme="outline" /> Methods
                        </TitleTemplate>
                        <Body>
                            <ExpandableTextListSection Items="@DatasetMethodItems" OnToggle="@ToggleExpandableText" />
                        </Body>
                    </Card>
                </AntDesign.Col>
            </Row>

            @if (Metadata.Dataset.ParentDatasets != null && Metadata.Dataset.ParentDatasets.Any())
            {
                <Row>
                    <AntDesign.Col Span="24" Style="padding:5px">
                        <Card>
                            <TitleTemplate>
                                <Icon Type="partition" Theme="outline" Rotate="180" /> Lineage Diagram
                            </TitleTemplate>
                            <Body>
                                <DatasetLineageSection Dataset="@Metadata.Dataset" />
                            </Body>
                        </Card>
                    </AntDesign.Col>
                </Row>
            }

            <Row>
                <AntDesign.Col Span="24" Style="padding:5px">
                    <Card>
                        <TitleTemplate>
                            <Icon Type="comment" Theme="outline" /> Derived Works
                        </TitleTemplate>
                        <Body>
                            <ExpandableTextListSection Items="@DerivedWorkItems" OnToggle="@ToggleExpandableText" />
                        </Body>
                    </Card>
                </AntDesign.Col>
            </Row>

            <Row>
                <AntDesign.Col Span="24" Style="padding:5px">
                    <Card>
                        <TitleTemplate>
                            <Icon Type="database" Theme="outline" /> File Information
                        </TitleTemplate>
                        <Body>
                            <DatasetFileInformationSection Dataset="@Metadata.Dataset" />
                        </Body>
                    </Card>
                </AntDesign.Col>
            </Row>

            <Row>
                <AntDesign.Col Span="24" Style="padding:5px;">
                    <Card>
                        <TitleTemplate>
                            <Icon Type="calculator" Theme="outline" /> Variables
                        </TitleTemplate>
                        <Body>
                            <DatasetVariablesSection VariableRows="@VariableRows"
                                                      TableWidth="@TableWidth"
                                                      VariablePageSize="@VariablePageSize"
                                                      VarsHaveMethods="@VarsHaveMethods"
                                                      VarsHaveQCApplied="@VarsHaveQCApplied"
                                                      VarsHaveProcessingLevel="@VarsHaveProcessingLevel"
                                                      VarsHaveVariableType="@VarsHaveVariableType"
                                                      VarsHaveTags="@VarsHaveTags"
                                                      FilterProcessing="@FilterProcessing"
                                                      FilterVariableType="@FilterVariableType"
                                                      OnToggleDescription="@ToggleVariableDescription"
                                                      OnToggleMethods="@ToggleVariableMethods"
                                                      OnDownload="@DownloadVariables" />
                        </Body>
                    </Card>
                </AntDesign.Col>
            </Row>
        </AntDesign.Col>

        <AntDesign.Col Xs="@Property(24,0)" Lg="@Property(7,0)">
            <Row>
                <AntDesign.Col Span="24" Style="padding:5px">
                    <Card>
                        <TitleTemplate>
                            <Icon Type="environment" Theme="outline" /> Spatial Information
                        </TitleTemplate>
                        <Body>
                            <DatasetSpatialSection Dataset="@Metadata.Dataset" />
                        </Body>
                    </Card>
                </AntDesign.Col>
            </Row>

            <Row>
                <AntDesign.Col Span="24" Style="padding:5px;">
                    <Card>
                        <TitleTemplate>
                            <Icon Type="clock-circle" Theme="outline" /> Temporal Information
                        </TitleTemplate>
                        <Body>
                            <DatasetTemporalSection Dataset="@Metadata.Dataset" />
                        </Body>
                    </Card>
                </AntDesign.Col>
            </Row>

            <Row>
                <AntDesign.Col Span="24" Style="padding:5px">
                    <Card>
                        <TitleTemplate>
                            <Icon Type="user" Theme="outline" /> Contacts
                        </TitleTemplate>
                        <Body>
                            <DatasetContactsSection Dataset="@Metadata.Dataset" />
                        </Body>
                    </Card>
                </AntDesign.Col>
            </Row>

            <Row>
                <AntDesign.Col Span="24" Style="padding:5px">
                    <Card>
                        <TitleTemplate>
                            <Icon Type="tags" Theme="outline" /> Tags
                        </TitleTemplate>
                        <Body>
                            <DatasetTagsSection Dataset="@Metadata.Dataset" />
                        </Body>
                    </Card>
                </AntDesign.Col>
            </Row>
        </AntDesign.Col>
    </Row>

    <AntDesign.Modal Title="Description" Visible="@ShowDescription" DestroyOnClose="true" Width="1200" OnCancel="@CloseDescription" Footer="@null">
        @if (ShowDescription)
        {
            <DatasetDescriptionSection DescriptionHtml="@DescriptionHtml" CanExpand="@CanExpandDescription" IsExpanded="@IsDescriptionExpanded" OnToggle="@ToggleDescription" />
            <div class="details-modal-footer">
                <AntDesign.Button @onclick="CloseDescription">Close</AntDesign.Button>
            </div>
        }
    </AntDesign.Modal>

    <AntDesign.Modal Title="Methods" Visible="@ShowDatasetMethods" DestroyOnClose="true" Width="1200" OnCancel="@CloseDatasetMethods" Footer="@null">
        @if (ShowDatasetMethods)
        {
            <ExpandableTextListSection Items="@DatasetMethodItems" OnToggle="@ToggleExpandableText" />
            <div class="details-modal-footer">
                <AntDesign.Button @onclick="CloseDatasetMethods">Close</AntDesign.Button>
            </div>
        }
    </AntDesign.Modal>

    <AntDesign.Modal Title="Lineage Diagram" Visible="@ShowLineage" DestroyOnClose="true" Width="1200" OnCancel="@CloseLineage" Footer="@null" WrapClassName="lineage-diagram-modal-wrap">
        @if (ShowLineage)
        {
            <DatasetLineageSection @ref="_lineageSection" Dataset="@Metadata.Dataset" DiagramHeight="460" />
            <div class="details-modal-footer">
                <AntDesign.Button @onclick="CloseLineage">Close</AntDesign.Button>
            </div>
        }
    </AntDesign.Modal>

    <AntDesign.Modal Title="Derived Works" Visible="@ShowDerivedWorks" DestroyOnClose="true" Width="1200" OnCancel="@CloseDerivedWorks" Footer="@null">
        @if (ShowDerivedWorks)
        {
            <ExpandableTextListSection Items="@DerivedWorkItems" OnToggle="@ToggleExpandableText" />
            <div class="details-modal-footer">
                <AntDesign.Button @onclick="CloseDerivedWorks">Close</AntDesign.Button>
            </div>
        }
    </AntDesign.Modal>

    <AntDesign.Modal Title="File Information" Visible="@ShowFileInformation" DestroyOnClose="true" Width="1200" OnCancel="@CloseFileInformation" Footer="@null">
        @if (ShowFileInformation)
        {
            <DatasetFileInformationSection Dataset="@Metadata.Dataset" />
            <div class="details-modal-footer">
                <AntDesign.Button @onclick="CloseFileInformation">Close</AntDesign.Button>
            </div>
        }
    </AntDesign.Modal>

    <AntDesign.Modal Title="Variables" Visible="@ShowVariables" DestroyOnClose="true" Width="1200" OnCancel="@CloseVariables" Footer="@null">
        @if (ShowVariables)
        {
            <DatasetVariablesSection VariableRows="@VariableRows"
                                      TableWidth="@TableWidth"
                                      VariablePageSize="@VariablePageSize"
                                      VarsHaveMethods="@VarsHaveMethods"
                                      VarsHaveQCApplied="@VarsHaveQCApplied"
                                      VarsHaveProcessingLevel="@VarsHaveProcessingLevel"
                                      VarsHaveVariableType="@VarsHaveVariableType"
                                      VarsHaveTags="@VarsHaveTags"
                                      FilterProcessing="@FilterProcessing"
                                      FilterVariableType="@FilterVariableType"
                                      OnToggleDescription="@ToggleVariableDescription"
                                      OnToggleMethods="@ToggleVariableMethods"
                                      OnDownload="@DownloadVariables" />
            <div class="details-modal-footer">
                <AntDesign.Button @onclick="CloseVariables">Close</AntDesign.Button>
            </div>
        }
    </AntDesign.Modal>

    <AntDesign.Modal Title="Spatial Information" Visible="@ShowSpatialInformation" DestroyOnClose="true" Width="1200" OnCancel="@CloseSpatialInformation" Footer="@null">
        @if (ShowSpatialInformation)
        {
            <DatasetSpatialSection Dataset="@Metadata.Dataset" />
            <div class="details-modal-footer">
                <AntDesign.Button @onclick="CloseSpatialInformation">Close</AntDesign.Button>
            </div>
        }
    </AntDesign.Modal>

    <AntDesign.Modal Title="Temporal Information" Visible="@ShowTemporalInformation" DestroyOnClose="true" Width="1200" OnCancel="@CloseTemporalInformation" Footer="@null">
        @if (ShowTemporalInformation)
        {
            <DatasetTemporalSection Dataset="@Metadata.Dataset" />
            <div class="details-modal-footer">
                <AntDesign.Button @onclick="CloseTemporalInformation">Close</AntDesign.Button>
            </div>
        }
    </AntDesign.Modal>

    <AntDesign.Modal Title="Contacts" Visible="@ShowContacts" DestroyOnClose="true" Width="1200" OnCancel="@CloseContacts" Footer="@null">
        @if (ShowContacts)
        {
            <DatasetContactsSection Dataset="@Metadata.Dataset" />
            <div class="details-modal-footer">
                <AntDesign.Button @onclick="CloseContacts">Close</AntDesign.Button>
            </div>
        }
    </AntDesign.Modal>

    <AntDesign.Modal Title="Tags" Visible="@ShowTags" DestroyOnClose="true" Width="1200" OnCancel="@CloseTags" Footer="@null">
        @if (ShowTags)
        {
            <DatasetTagsSection Dataset="@Metadata.Dataset" />
            <div class="details-modal-footer">
                <AntDesign.Button @onclick="CloseTags">Close</AntDesign.Button>
            </div>
        }
    </AntDesign.Modal>
}
