@using Caf.Midden.Wasm.Services
@inject IJSRuntime JS
@implements IAsyncDisposable

<div @ref="map" id="@_mapId" class="catalog-coverage-map"></div>

@code {
    private readonly string _mapId = $"coverage-map-{Guid.NewGuid():N}";

    ElementReference map;
    IJSObjectReference? mapModule;
    IJSObjectReference? mapInstance;
    bool initializing;

    [Parameter]
    public IReadOnlyList<SpatialBoundingBox> Boxes { get; set; } = Array.Empty<SpatialBoundingBox>();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The flag is set synchronously: mapModule is only assigned after two awaits, so a
        // second render pass would otherwise initialize Leaflet on the same container again.
        if (!initializing && mapModule == null && Boxes.Count > 0)
        {
            initializing = true;

            mapModule = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./geojsonMap.js");
            mapInstance = await mapModule.InvokeAsync<IJSObjectReference>(
                "createBoxes", map, Boxes);
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        try
        {
            if (mapModule != null && mapInstance != null)
            {
                await mapModule.InvokeVoidAsync("destroy", mapInstance);
            }

            if (mapInstance != null)
            {
                await mapInstance.DisposeAsync();
            }

            if (mapModule != null)
            {
                await mapModule.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
